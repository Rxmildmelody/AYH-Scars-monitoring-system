<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Patient List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container-fluid">
            <a class="navbar-brand" href="dashboard.html">ระบบติดตามผู้ป่วย</a>
            <div class="d-flex text-white align-items-center">
                <span class="me-3">ยินดีต้อนรับ, เภสัชกร</span>
                <a href="index.html" class="btn btn-sm btn-danger">ออกจากระบบ</a>
            </div>
        </div>
    </nav>

    <!-- Content -->
    <div class="container mt-4">
        <div class="row mb-3 align-items-center">
            <div class="col-md-6">
                <h3>รายชื่อผู้ป่วยทั้งหมด</h3>
            </div>
            <div class="col-md-6 text-end">
                <button class="btn btn-success" data-bs-toggle="modal" data-bs-target="#addPatientModal">+ เพิ่มผู้ป่วยใหม่</button>
            </div>
        </div>

        <!-- กล่องค้นหา -->
        <div class="card mb-4 shadow-sm">
            <div class="card-body">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="ค้นหาด้วยชื่อ, สกุล หรือ Case ID...">
                    <button class="btn btn-outline-secondary" type="button">ค้นหา</button>
                </div>
            </div>
        </div>

        <!-- ตารางข้อมูล -->
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Case ID</th>
                                <th>ชื่อ - นามสกุล</th>
                                <th>สถานะ</th>
                                <th>จัดการ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>C-001</td>
                                <td>สมชาย ตัวอย่าง</td>
                                <td><span class="badge bg-warning text-dark">เฝ้าระวัง</span></td>
                                <td><button class="btn btn-sm btn-info text-white">เปิดดู</button></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal เพิ่มผู้ป่วยใหม่ (Popup หน้าต่างจำลอง) -->
    <div class="modal fade" id="addPatientModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">เพิ่มผู้ป่วยใหม่</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form>
                        <div class="mb-2"><label>ชื่อ-สกุล</label><input type="text" class="form-control"></div>
                        <div class="mb-2"><label>อายุ</label><input type="number" class="form-control"></div>
                        <div class="mb-2"><label>โรคประจำตัว</label><input type="text" class="form-control"></div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="button" class="btn btn-primary">บันทึกข้อมูล</button>
                </div>
            </div>
        </div>
    </div>

    <!-- จำเป็นสำหรับการทำให้ Modal (Popup) ทำงานได้ -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
